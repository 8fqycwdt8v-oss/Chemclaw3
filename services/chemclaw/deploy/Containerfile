# Single multi-target image for every Chemclaw component (plan F6-T1).
#
# One image, one dependency closure; the *component* is chosen at runtime by CHEMCLAW_COMPONENT
# (see deploy/entrypoint.sh), so the service, the two Temporal workers, and the MCP servers all ship
# the same bits and differ only by entrypoint. UBI9 + a non-root UID keeps it OpenShift-SCC-friendly
# (arbitrary high UID at runtime); no secret is ever baked in — all config arrives via env/mounts.
FROM registry.access.redhat.com/ubi9/python-311:latest

# uv drives the install to match local/CI exactly (same lockfile). Copy metadata first for layer reuse.
# `git` is a hard runtime dependency, not a convenience: the PR-gate submitter shells out to it
# (`kg/git_submitter.py`) and the knowledge-sync sidecar clones/pulls the note repo with it, so an
# image without git silently breaks both directions of the knowledge layer.
USER 0
RUN dnf install -y git && dnf clean all && pip install --no-cache-dir uv
WORKDIR /app

# The two calculation binaries (xTB plan X5/X6). Pinned release tarballs rather than a
# package manager, because UBI9 has neither in its repositories and a pinned artifact is
# what makes the image reproducible. Both are optional at *runtime* — `calc.xtb_cli` and
# `calc.crest_cli` fall back or report unavailable — but a worker image without them
# loses the 9-11x ANCopt speedup and conformer sampling entirely.
#
# Licensing: xtb is LGPL-3.0, crest is GPL-3.0. Both are invoked as separate processes
# over files and never linked, so the usual analysis is that neither affects this
# codebase's licence — but *distributing* them inside an image is a decision for whoever
# owns the product. Drop the crest layer to ship without it.
ARG XTB_VERSION=6.6.1
ARG CREST_VERSION=3.0.2
RUN set -eux; \
    curl -fsSL -o /tmp/xtb.tar.xz \
      "https://github.com/grimme-lab/xtb/releases/download/v${XTB_VERSION}/xtb-${XTB_VERSION}-linux-x86_64.tar.xz"; \
    tar -xJf /tmp/xtb.tar.xz -C /opt; \
    ln -s "/opt/xtb-dist/bin/xtb" /usr/local/bin/xtb 2>/dev/null || \
      ln -s "/opt/xtb-${XTB_VERSION}/bin/xtb" /usr/local/bin/xtb; \
    curl -fsSL -o /tmp/crest.tar.xz \
      "https://github.com/crest-lab/crest/releases/download/v${CREST_VERSION}/crest-gnu-12-ubuntu-latest.tar.xz"; \
    mkdir -p /opt/crest && tar -xJf /tmp/crest.tar.xz -C /opt/crest --strip-components=1; \
    install -m 0755 /opt/crest/crest /usr/local/bin/crest; \
    rm -f /tmp/xtb.tar.xz /tmp/crest.tar.xz; \
    xtb --version >/dev/null && crest --version >/dev/null

COPY pyproject.toml uv.lock README.md ./
# Copy the source needed to build the wheel + run every component.
COPY chemclaw ./chemclaw
COPY agents ./agents
COPY service ./service
COPY workflows ./workflows
COPY workers ./workers
COPY mcp_servers ./mcp_servers
COPY report ./report
COPY bo ./bo
COPY eln ./eln
COPY calc ./calc
COPY infra ./infra
COPY kg ./kg
COPY memory ./memory
COPY sources ./sources
# The connector bundles: their manifests, their FastAPI apps, and any skills/profiles they ship.
# One image serves every component including each connector (the entrypoint dispatches on
# CHEMCLAW_COMPONENT=connector-<name>), so adding a bundle needs no change here.
COPY connectors ./connectors
COPY safety ./safety
# The two file-defined extension seams beside connectors: `templates/` holds the step templates
# (code plus the shipped YAML) and `profiles/` the cross-capability agent profiles. Both are
# discovered from disk at start-up, so an image missing them silently advertises fewer
# capabilities rather than failing — which is why they are COPYd explicitly.
COPY templates ./templates
COPY profiles ./profiles
# Not optional extras: `skills/` IS the agent's judgment layer (an image without it advertises no
# skills at all), `scripts/` owns the Temporal Schedules that fire every periodic job, and `evals/`
# carries the committed case-set + baseline the drift job scores against. `knowledge/` seeds the
# note tree so the mount point exists even before the first sync.
COPY skills ./skills
COPY scripts ./scripts
COPY evals ./evals
COPY knowledge ./knowledge
COPY deploy/entrypoint.sh /usr/local/bin/chemclaw-entrypoint
COPY deploy/knowledge-sync.sh /usr/local/bin/chemclaw-knowledge-sync

# Install into a project venv; --frozen fails if the lockfile drifted (reproducible builds).
RUN uv sync --frozen --no-dev \
    && chmod +x /usr/local/bin/chemclaw-entrypoint /usr/local/bin/chemclaw-knowledge-sync \
    && chown -R 1001:0 /app \
    && chmod -R g=u /app

# Non-root by default; OpenShift may override with an arbitrary UID (still in group 0).
USER 1001
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    CHEMCLAW_COMPONENT=service

ENTRYPOINT ["/usr/local/bin/chemclaw-entrypoint"]
