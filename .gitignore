# The repository hosts one Python service, `services/chemclaw/`, which carries its own
# .gitignore for anything service-local. This file covers what shows up at any path.

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
/coverage
.coverage
htmlcov/

# IDEs and editors
/.idea
.project
.classpath
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# System files
.DS_Store
Thumbs.db
