# Chemclaw environment configuration — copy to `.env` and adjust.
#
# Every value maps to a field in `src/chemclaw/core/config/` (prefix CHEMCLAW_), and
# this file lists every field, at its default. The defaults match
# `infra/docker-compose.yml`, so the local dev stack works with no `.env` at
# all; override here to point at other environments.
#
# First local run: you do not need this file. The one setting worth knowing about is the LLM
# credential — CHEMCLAW_LLM_PROVIDER defaults to the `anthropic` dev fallback below, and that
# client reads its key from ANTHROPIC_API_KEY, its own native env var, not a CHEMCLAW_ setting
# (see the F0 block further down). Everything else already matches the dev stack `make up`
# brings up, so copy this file only when you need to override something.

# Logging: one verbosity switch for troubleshooting (raise to DEBUG) + the line format.
# Applied at each worker's entrypoint by chemclaw.logging.configure_logging.
CHEMCLAW_LOG_LEVEL=INFO
CHEMCLAW_LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
# GxP tool-audit trail: max characters of a tool call's arguments logged per audit line. The turn's
# `tool_call` event applies the same budget to its preview, so one value covers both.
CHEMCLAW_AGENT_AUDIT_MAX_ARG_CHARS=200
# Suffix for the retrieved-content envelope that marks untrusted text as data (agent/framing.py).
# Empty = a random per-process value (dev/tests). Set it wherever sessions are durable: Postgres
# history outlives the process that framed it and is replayed by other replicas, and only an
# envelope with exactly the current tag counts — so a per-process tag lets the injection
# mitigation lapse for older content. Hashed before use; never appears in a prompt.
CHEMCLAW_FRAMING_ENVELOPE_SECRET=

# How many distinct numeric values one tool result may put on a `tool_result` event. A ceiling, not
# a budget: the largest real result measured holds 49. Lower it if a chatty connector floods a UI.
CHEMCLAW_STREAM_MAX_RESULT_NUMBERS=512
# How large one tool result may be, in UTF-8 bytes, and still be stored for a surface to fetch via
# GET /sessions/{id}/tool-results/{ref}. Over the cap it is not stored at all (never truncated — a
# trimmed result still looks whole) and its `result_ref` stays empty. 0 disables the store.
CHEMCLAW_STREAM_MAX_RESULT_BYTES=131072
# Deployment revision (Git SHA / image digest) stamped onto every audit row (AG-14). The F6 image
# build sets this; "unknown" until then.
CHEMCLAW_DEPLOYMENT_REVISION=unknown
# OpenTelemetry export (off by default). Enable to emit spans to an OTLP collector configured via
# the standard OTEL_EXPORTER_OTLP_ENDPOINT env var; requires the OpenTelemetry SDK + OTLP exporter
# extras installed.
CHEMCLAW_OTEL_ENABLED=false
# A span per *model call*, through OpenInference's LangChain instrumentation: token counts, model
# name and provider, plus the chain and tool spans around them. Any OTLP backend receives these;
# Arize Phoenix reads the conventions natively and is what they were measured against. This is what
# answers "which model, how many tokens, how long" — chemclaw_*_tokens_total carries `profile` only.
CHEMCLAW_OTEL_LLM_SPANS=false
# Whether those spans may carry prompts and completions. Off means every OpenInference hide flag is
# set, so a span carries identifiers and counts and nothing a chemist typed. Turning it on is a
# decision about content leaving the pod, not a debugging convenience — the collector's store then
# holds the same class of data SECURITY.md describes for the audit trail. It governs nothing while
# CHEMCLAW_OTEL_LLM_SPANS is off, and the process says so at WARNING if you set it anyway.
CHEMCLAW_OTEL_INCLUDE_SENSITIVE_DATA=false
# Whether Chemclaw leaves LangSmith's own tracing switches (LANGSMITH_TRACING /
# LANGCHAIN_TRACING_V2) alone. Off, so it does not: at startup it disables langsmith tracing in
# process and writes both names false, because `langsmith` ships in the runtime closure whether or
# not it is wanted (langchain-core requires it, deepagents pulls it again) and enables itself from
# ambient environment — measured, one truthy variable sends prompts and completions to
# api.smith.langchain.com with no Chemclaw code involved. D-2026-08-11 declined LangSmith for the
# production path. Setting this true does NOT enable tracing; it hands the choice back to your
# environment, for a developer deliberately debugging against their own LangSmith project.
CHEMCLAW_LANGSMITH_TRACING_ALLOWED=false

# Temporal frontend gRPC endpoint and namespace (durable job execution).
CHEMCLAW_TEMPORAL_ADDRESS=localhost:7233
CHEMCLAW_TEMPORAL_NAMESPACE=default

# Core's task queue for the light background jobs (sync, re-index, reports, the connector-job
# wrapper). A connector bundle's own queue is derived from its name, not configured here.
CHEMCLAW_BACKGROUND_TASK_QUEUE=background-jobs

# Postgres/pgvector connection (fingerprint store + calculation cache) and the
# libpq connect timeout (fail fast when the database is unreachable).
CHEMCLAW_POSTGRES_DSN=postgresql://chemclaw:chemclaw@localhost:5432/chemclaw
# The credential that owns the schema, as distinct from the one that serves requests. Empty falls
# back to POSTGRES_DSN, which is a single-principal database — what dev, CI and `make up` run, and
# what needs no configuration. Set it (plus a `chemclaw_app` role and `make db-grants`) and the
# runtime credential loses DDL and loses UPDATE/DELETE on audit_events, so the credential that runs
# a chat turn can no longer rewrite the GxP trail recording that turn. Belongs on the migration
# hook Job only, never on a long-lived pod.
CHEMCLAW_POSTGRES_MIGRATION_DSN=
# The ordered .sql migrations `make db-migrate` applies, relative to the working directory.
CHEMCLAW_SQL_MIGRATIONS_DIR=infra/sql
CHEMCLAW_PG_CONNECT_TIMEOUT_SECONDS=10

# Per-process connection pool. The front door and every worker borrow from this instead of
# opening a connection per call (which was measured at ~2.7 handshakes per chat turn, and whose
# scheduling latency under load failed connects while the database itself was idle).
# Deployment total = MAX_SIZE x distinct DSNs x processes; keep it under the server's
# max_connections. TIMEOUT is how long a caller waits for a free connection before the request
# fails as a transient infrastructure fault.
CHEMCLAW_PG_POOL_MIN_SIZE=2
CHEMCLAW_PG_POOL_MAX_SIZE=16
CHEMCLAW_PG_POOL_MAX_IDLE_SECONDS=300.0
CHEMCLAW_PG_POOL_TIMEOUT_SECONDS=10.0

# The fleet connection budget: the "keep it under max_connections" sentence above, as a check.
# POOLED_PROCESSES is how many processes may open a pool at once (every front-door pod, every
# Temporal worker, every connector server); the Helm chart derives it from the same values that
# render those Deployments. MAX_CONNECTIONS is what the server will actually serve this
# deployment. Startup fails if POOLED_PROCESSES x POOL_MAX_SIZE exceeds it, naming both sides.
# 0 = undeclared, which makes the check (and the matching alert) inert — the default here,
# because a single-process dev run has no fleet.
CHEMCLAW_PG_FLEET_POOLED_PROCESSES=1
CHEMCLAW_PG_FLEET_MAX_CONNECTIONS=0

# Artifact store (D-124): a calculation's by-products — Hessians, optimized geometries, conformer
# ensembles — kept past the temporary directory that used to delete them, so a second question
# about the same molecule reuses them instead of recomputing. Content-addressed, so two runs that
# produced identical bytes store one copy.
#
# An artifact over MAX_BYTES is skipped with a warning, never an error: capturing a by-product
# must not be able to fail the calculation it is a by-product of. COMPRESSION_LEVEL is zlib's
# (0 stores raw). The two eviction knobs are both 0 = off; eviction targets blobs only, never
# calculation_results, because the result is the answer and the blob is regenerable (D-011).
CHEMCLAW_ARTIFACT_STORE_ENABLED=true
CHEMCLAW_ARTIFACT_MAX_BYTES=33554432
CHEMCLAW_ARTIFACT_COMPRESSION_LEVEL=6
CHEMCLAW_ARTIFACT_STORE_MAX_BYTES=0
CHEMCLAW_ARTIFACT_EVICT_IDLE_DAYS=0
# How often the eviction sweep runs, once either bound above is non-zero.
CHEMCLAW_ARTIFACT_EVICTION_SCHEDULE_MINUTES=1440.0
CHEMCLAW_ARTIFACT_ACCESS_STAMP_SECONDS=3600.0

# Where dense vectors live (D-2026-08-08-a-vector-store-is-not-a-catalogue). `pgvector` keeps them
# in the same Postgres and answers a search in one statement — ranking, eligibility and the citation
# join together. Any other provider moves *only* the dense half: the file table, the fingerprint
# diff, the mark-and-sweep and the lexical leg stay here, so Postgres is still required.
# `qdrant-client` is deliberately not a runtime dependency — install it in the image that reaches
# Qdrant. The collection must be created with cosine distance and a payload index on `group`.
CHEMCLAW_VECTOR_STORE_PROVIDER=pgvector
CHEMCLAW_VECTOR_STORE_URL=http://localhost:6333
CHEMCLAW_VECTOR_STORE_API_KEY=
CHEMCLAW_VECTOR_STORE_TIMEOUT_SECONDS=30.0
CHEMCLAW_VECTOR_STORE_DOCUMENT_COLLECTION=chemclaw_document_chunks

# QM job timing (seconds). The mock_* values shape the simulated HPC job only.
# The poll interval must stay below the heartbeat timeout (validated at startup).
CHEMCLAW_QM_ACTIVITY_TIMEOUT_SECONDS=30.0
CHEMCLAW_QM_POLL_HEARTBEAT_TIMEOUT_SECONDS=10.0
CHEMCLAW_HPC_POLL_INTERVAL_SECONDS=2.0
CHEMCLAW_HPC_MOCK_SUBMIT_SECONDS=1.0
CHEMCLAW_HPC_MOCK_RUN_SECONDS=6.0
# How many consecutive poll errors a running QM job tolerates before it fails (a transient
# launcher/API blip must not kill a long HPC run; a persistent outage still terminates it).
CHEMCLAW_HPC_POLL_MAX_CONSECUTIVE_ERRORS=30
# Bearer token for the artifact store the launcher fetches job outputs from (empty = none).
CHEMCLAW_HPC_ARTIFACT_STORE_TOKEN=
# Persist a finished QM result in the shared calculation store, so an expensive cluster run is
# cached like every other calculation (D-011/D-158). Turn off only where the qm worker has no
# reachable Postgres.
CHEMCLAW_QM_PERSIST_TO_CALC_STORE=true

# xTB semiempirical calculator: GFN parametrization + RDKit 3D-embedding seed
# (both are part of the cache key — changing them recomputes).
CHEMCLAW_XTB_METHOD=GFN2-xTB
CHEMCLAW_XTB_EMBED_SEED=42
# Decimals a structure's coordinates are rounded to before it is hashed (0.1 pm at 4),
# so float noise cannot fork the cache. Part of the structure id: changing it recomputes.
CHEMCLAW_XTB_GEOMETRY_DECIMALS=4
# Wiberg bond order above which a pair of atoms is reported as bonded.
CHEMCLAW_XTB_BOND_ORDER_THRESHOLD=0.5
# Default number of atoms a site-reactivity (Fukui) ranking returns.
CHEMCLAW_XTB_FUKUI_TOP_N=15

# Geometry optimization: convergence on the largest gradient component (Hartree/Angstrom),
# the step cap, and the per-leg trust radius (Angstrom) that keeps a strained starting
# geometry from being thrown somewhere the SCF cannot converge.
CHEMCLAW_XTB_OPT_GRADIENT_TOLERANCE=5e-4
CHEMCLAW_XTB_OPT_MAX_STEPS=1500
CHEMCLAW_XTB_OPT_TRUST_RADIUS=0.35
# Curvature assumed for the directions the ANC preconditioner's model cannot see.
CHEMCLAW_XTB_ANC_CURVATURE_FLOOR=1.0
# Hessian: central-difference step (Angstrom) and the atom ceiling above which a
# finite-difference Hessian is refused rather than attempted.
CHEMCLAW_XTB_HESSIAN_DISPLACEMENT=0.005
CHEMCLAW_XTB_HESSIAN_MAX_ATOMS=150
# Thermochemistry reference conditions, the quasi-RRHO damping frequency below which a
# vibration is treated as a free rotor, and the magnitude above which a negative Hessian
# eigenvalue counts as a real imaginary mode rather than finite-difference noise.
CHEMCLAW_XTB_THERMO_TEMPERATURE_K=298.15
CHEMCLAW_XTB_THERMO_PRESSURE_PA=101325.0
CHEMCLAW_XTB_RRHO_CUTOFF_CM=25.0
CHEMCLAW_XTB_IMAGINARY_THRESHOLD_CM=25.0
# Escaping a saddle point: how many times a non-minimum may be displaced along its
# imaginary mode and re-optimized, and how far the largest atom moves (Angstrom).
CHEMCLAW_XTB_MINIMUM_REFINEMENT_ATTEMPTS=2
CHEMCLAW_XTB_IMAGINARY_KICK_ANGSTROM=0.3
# Reported uncertainty on a semiempirical reaction free energy (kcal/mol), the point cap
# on a relaxed scan, and the number of IR bands a thermochemistry result reports.
CHEMCLAW_XTB_REACTION_UNCERTAINTY_KCAL=3.0
CHEMCLAW_XTB_SCAN_MAX_POINTS=24
CHEMCLAW_XTB_IR_BANDS_TOP_N=12
# Inline-vs-durable routing: predicted seconds above which an xTB request becomes a
# Temporal job, the cost model it is predicted with, and that job's activity budget.
CHEMCLAW_XTB_JOB_TIMEOUT_SECONDS=14400
CHEMCLAW_XTB_JOB_HEARTBEAT_TIMEOUT_SECONDS=600

# Which backend runs an xTB task: "auto" prefers the binary when installed (ANCopt is
# 9-11x faster on drug-sized molecules) and falls back to the in-process library. The
# resolved name — never "auto" — goes into the cache key.
CHEMCLAW_XTB_ENGINE=auto
CHEMCLAW_XTB_BINARY=xtb
CHEMCLAW_XTB_CLI_ACCURACY=1.0
CHEMCLAW_XTB_CLI_TIMEOUT_SECONDS=3600
CHEMCLAW_XTB_CLI_OPT_LEVEL=vtight
# Threads for the binary; 0 leaves xtb's own default (uses the machine), which is right
# for a dedicated worker pod. Pin to 1 only where many activities share a pod.
CHEMCLAW_XTB_CLI_THREADS=0
# Media a solvent screen evaluates at once. 1 is serial — the shipped behaviour — because a
# branch spawns xtb and the setting above lets that binary size itself to the whole machine,
# so raising this is paired with pinning XTB_CLI_THREADS. Worth measuring on a pod with cores
# to spare; a screen is one reaction per solvent and they genuinely serialize.
CHEMCLAW_CALC_SCREEN_MAX_PARALLEL=1
# CREST conformer/tautomer/protomer sampling (GPL-3.0, optional — absent, the ensemble
# tasks say so and everything else works).
CHEMCLAW_CREST_BINARY=crest
CHEMCLAW_CREST_EFFORT=quick
CHEMCLAW_CREST_MAX_MEMBERS=20
CHEMCLAW_CREST_THREADS=0
CHEMCLAW_CREST_TIMEOUT_SECONDS=14400
# Cost of a conformer search in the inline-vs-durable router (it is never inline).

# xTB pKa predictor: solvent + linear calibration + reported model uncertainty.
CHEMCLAW_PKA_SOLVENT=water
CHEMCLAW_PKA_CALIBRATION_SLOPE=0.28733
CHEMCLAW_PKA_CALIBRATION_INTERCEPT=-29.3116
CHEMCLAW_PKA_UNCERTAINTY=1.6
# Conjugate-acid pKa of a base: its own calibration, fitted on aromatic/aryl nitrogen
# (aliphatic amines are refused — the continuum solvent cannot rank them).
CHEMCLAW_PKA_BASE_CALIBRATION_SLOPE=0.241396
CHEMCLAW_PKA_BASE_CALIBRATION_INTERCEPT=-22.1843
CHEMCLAW_PKA_BASE_UNCERTAINTY=1.0

# Solubility model: reported log-S RMSE attached to every prediction.
CHEMCLAW_SOLUBILITY_RMSE_LOG=0.75
# Split-conformal intervals over this deployment's own reconciled residuals (F8-T1). A conformal
# interval is a claim about *this* system's chemistry; the reported RMSE above is a claim about a
# paper's test set, and `Estimate.method` says which one a prediction carried. Coverage is the
# fraction of future predictions the interval should contain — 0.9 rather than 0.95 because the
# guarantee needs ceil((n+1)*coverage) <= n observations to exist at all, so 0.95 needs 19
# measurements and 0.9 needs 9. `min_samples` is a floor beneath that arithmetic one: nine
# residuals give a valid interval that one unusual compound sets.
CHEMCLAW_CALIBRATION_CONFORMAL_COVERAGE=0.9
CHEMCLAW_CALIBRATION_CONFORMAL_MIN_SAMPLES=20

# logD (calc.logd, D-092): working pH used when a caller does not name one, and the ionised
# fraction of the one site `calc.pka` reports at or below which further unmodelled sites of the
# same kind can still be dismissed. Above it a polyprotic molecule is refused rather than given a
# single-equilibrium number (an amphoteric one is refused at every pH).
CHEMCLAW_LOGD_DEFAULT_PH=7.4
CHEMCLAW_LOGD_NEGLIGIBLE_IONISED_FRACTION=0.05

# Reaction energetics (calc.reaction_energy, D-092): exotherm-flag threshold, kcal/mol
# (negative = exothermic; a reaction energy at or below this is flagged).
CHEMCLAW_REACTION_ENERGY_EXOTHERM_THRESHOLD_KCAL=-20.0

# Conformer ensemble (workflows.conformer_job, D-092): ETKDG ensemble size, the MMFF
# energy-window prune (kcal/mol) before the xTB pass, the Boltzmann-weighting temperature (K),
# and the durable job's per-activity timeout budget (seconds).

# Bayesian-optimization campaign: per-activity budget + reproducibility seed.
CHEMCLAW_BO_ACTIVITY_TIMEOUT_SECONDS=300.0
# How long a BO activity may go without a heartbeat before Temporal declares the worker dead
# and retries (Conn-F2) — shorter than the budget above so a dead worker is noticed early.
CHEMCLAW_BO_ACTIVITY_HEARTBEAT_TIMEOUT_SECONDS=60.0
CHEMCLAW_BO_SEED=42
# Hard cap on rounds in one campaign — bounds a runaway ask-tell loop.
CHEMCLAW_BO_MAX_ROUNDS=500
# How many recent evaluations a plateau reading spans, and the fewest evaluations it will
# give a verdict on at all (below it, `campaign_progress` refuses rather than guessing).
CHEMCLAW_BO_PLATEAU_WINDOW=5
CHEMCLAW_BO_PLATEAU_MIN_OBSERVATIONS=6
# Folds for the cross-validated fit quality `predict_outcome` reports, and the run count below
# which that score is reported with the caveat that it will be over-read.
CHEMCLAW_BO_CV_FOLDS=5
CHEMCLAW_BO_FIT_QUALITY_TRUSTWORTHY_OBSERVATIONS=20

# The conversation agent: orchestration model name and where SKILL.md files are discovered.
# SKILLS_DIR is one or more directories, OS-path-separator delimited like PATH
# (e.g. skills:/opt/team-skills), so a second skills directory needs no code change.
CHEMCLAW_AGENT_MODEL=claude-sonnet-5
CHEMCLAW_SKILLS_DIR=skills
# Where agent profiles are discovered (a profile = instructions + tool/connector/harness overrides,
# selectable per session via `POST /sessions {"profile": ...}`). OS-path-separator delimited like
# PATH. A profile that spans capabilities lives here; one about a single capability lives in that
# connector's bundle (`connectors/<name>/profiles/`) and is found there too.
CHEMCLAW_PROFILES_DIR=data/profiles
# Where deterministic step templates are discovered (`data/templates/`, OS-path-separator delimited).
# A template fixes the *order* of a procedure and runs it as a durable job; a profile configures an
# agent and leaves the order to the model. `src/chemclaw/templates/README.md` says which one a task wants.
CHEMCLAW_TEMPLATES_DIR=data/templates
# Which discovered templates are advertised. Empty (the default) = every one found; a pathsep list
# narrows to exactly those, and an unknown name is caught by `make template-validate`.
CHEMCLAW_TEMPLATES_ENABLED=
# Per-step wall clock for a template run. Generous — an `agent` step is a model turn and a `tool`
# step may be a real calculation — but bounded, so one wedged step cannot pin a run forever.
CHEMCLAW_TEMPLATE_STEP_TIMEOUT_SECONDS=900.0
# Which discovered skills are actually advertised — discovery is not enablement. Empty (the
# default) means every skill found under SKILLS_DIR is active. Set an OS-path-separator list to
# narrow to a validated subset without deleting folders (e.g. deep-research:reaction-search).
# It only narrows: a name here that no directory provides is caught by `make skill-validate`.
CHEMCLAW_SKILLS_ENABLED=
# Role-scoped skill visibility (Phase 6): JSON map of skill name -> allowed Entra app-roles.
# A listed skill is hidden from a caller holding none of its roles; unlisted skills stay visible
# to all. Empty default = every skill visible. e.g. {"deep-research": ["process-chemist"]}
CHEMCLAW_SKILL_ROLE_GATES={}
# Testing CLI (`make chat` / `uv run chemclaw --admin`): the audit actor that admin-mode
# (auth-bypass, for use when CHEMCLAW_ENTRA_REQUIRED=false) runs are attributed to.
CHEMCLAW_CLI_ADMIN_ACTOR=admin@localhost
# The roles `--admin` holds. Empty means the flag bypasses *authentication* only: the tool gate and
# the expensive-trigger gate still apply, so knowledge writes and HPC jobs are refused. Set this
# explicitly (JSON list) for a full-access local seam. It was previously derived from
# CHEMCLAW_SKILL_ROLE_GATES above — a *visibility* map — so a role name appearing in both that and
# CHEMCLAW_ENTRA_PRIVILEGED_ROLES silently made this unauthenticated terminal fully privileged.
CHEMCLAW_CLI_ADMIN_ROLES=[]
# --- Connectors: the one way a capability is added (connectors/, docs/archive/plans/connector-plan.md) ---
# Where connector bundles are discovered. OS-path-separator delimited like PATH, so an operator can
# prepend a private bundle directory (earlier entries win a name collision).
# Unset: defaults to what ships inside the installed package (D-141). Set this only to add
# or override a directory; it stays an OS-pathsep list, earlier entries winning.
# CHEMCLAW_CONNECTORS_DIR=
# Which discovered bundles are enabled. Empty (the default) = every bundle found, so a fresh
# checkout runs the full shipped surface. A pathsep list narrows to exactly those names, in that
# order (tool order is part of the prompt, so it is configuration). An unknown name fails at startup.
CHEMCLAW_CONNECTORS_ENABLED=
# Per-connector endpoint override by name. A bundle's manifest ships a loopback dev default; a
# cluster's addresses belong to the deployment (the Helm chart computes this from .Values.connectors).
# `make connectors` prints the value for the composite dev runner. e.g.:
# CHEMCLAW_CONNECTOR_URLS='{"molfp":"http://127.0.0.1:8810/molfp/mcp"}'
CHEMCLAW_CONNECTOR_URLS={}
# What an unreachable enabled connector means. false (default) = degrade loudly: the service starts,
# /readyz reports it, the chemclaw_connectors_unhealthy gauge counts it, and that capability is
# simply unavailable. true = fail startup, for a deployment where a silently reduced tool surface is
# worse than not serving (the GxP posture).
CHEMCLAW_CONNECTORS_REQUIRED=false
# Bound on the startup/readiness health probe of one connector (runs before the pod is ready).
CHEMCLAW_CONNECTOR_HEALTH_TIMEOUT_SECONDS=2.0
# Whole-run ceiling for one connector job's child workflow. Generous (a connector job is the
# long-running kind) but bounded, so a wedged workflow fails instead of pinning a run forever.
# Deliberately global, not per-manifest: a bundle must not grant itself unlimited runtime. Must
# stay above the QM poll budget it bounds (CHEMCLAW_HPC_RUN_TIMEOUT_SECONDS on the nextflow path)
# plus the activities around it, or raising that budget changes nothing — checked at startup.
CHEMCLAW_CONNECTOR_JOB_TIMEOUT_SECONDS=90000.0
# Hard ceiling on a connector's request body, refused with 413 before anything reads it. A
# connector's own setting rather than CHEMCLAW_SERVICE_MAX_REQUEST_BYTES: that one is sized for the
# front door's multipart attachment upload, a shape a connector's /mcp never carries. 0 disables.
CHEMCLAW_CONNECTOR_MAX_REQUEST_BYTES=1000000
# The durable record every finished connector job writes (D-157): the write's own bound, and how
# many past runs `find_past_jobs` hands the model by default. Needs CHEMCLAW_SESSION_STORE=postgres
# — that switch is the deployment's statement that durable records belong in a database.
CHEMCLAW_JOB_RECORD_TIMEOUT_SECONDS=30.0
CHEMCLAW_JOB_RECORD_SEARCH_LIMIT=20
# Conversation context management. Compaction fires only when the running chat exceeds the
# token budget (char/4 estimate), then collapses stale tool-result dumps (keeping the newest
# N tool groups verbatim) and slides the conversation window; system instructions are kept.
CHEMCLAW_AGENT_CONTEXT_TOKEN_BUDGET=100000
CHEMCLAW_AGENT_KEEP_LAST_TOOL_GROUPS=2
CHEMCLAW_AGENT_KEEP_LAST_CONVERSATION_GROUPS=12

# Markdown knowledge graph + PR-gate git settings. `note_repo_dir` is the
# checkout the note submitter mutates — point it at a dedicated clone in
# production ("." only suits a dev checkout with nothing else running in it).
CHEMCLAW_KNOWLEDGE_DIR=knowledge
# Cache the parsed graph so retrieval does not re-parse the whole tree per query (KM-14); any note
# change busts it. Off makes every query re-parse.
CHEMCLAW_GRAPH_CACHE_ENABLED=true
# How long (seconds) a note-tree stat scan may be reused before scanning again (DA-5). The scan is
# O(notes) and is paid on every query even when the cache hits — it is the interactive-latency
# floor, and much worse on a networked PVC than local disk. Within this window a warm query does no
# scan at all. Cost: a note changed by another pod or an out-of-band `git pull` can lag by up to
# this long. Writes made by this process bypass it (the PR-gate submitter busts the cache), so the
# authoring loop is unaffected. Set 0 where no staleness is acceptable — that re-scans every query.
# 60s, not 5s: the only out-of-process writer is the knowledge-sync sidecar on a 300s cadence, so a
# shorter window cannot surface a merged note any sooner — it only re-scans.
CHEMCLAW_GRAPH_CACHE_TTL_SECONDS=60.0
# Max link-expansion depth for the expand_note tool (SEC-4; larger values are clamped).
CHEMCLAW_GRAPH_MAX_HOPS=3
# Max notes find_notes returns; a broad substring would otherwise flood the model context.
# Hitting the cap logs a warning (never a silent truncation).
CHEMCLAW_GRAPH_MAX_RESULTS=50
# How many hub notes find_knowledge_gaps reports.
CHEMCLAW_GRAPH_ANALYTICS_TOP_N=5
CHEMCLAW_NOTE_BASE_BRANCH=main
CHEMCLAW_GIT_REMOTE=origin
CHEMCLAW_NOTE_REPO_DIR=.
CHEMCLAW_NOTE_WRITE_TIMEOUT_SECONDS=120.0
CHEMCLAW_NOTE_WRITE_MAX_ATTEMPTS=3
# How much of a failed submission's git error the note_proposals record keeps. A length bound
# only: credentials are redacted before this cut, not by it.
CHEMCLAW_PROPOSAL_REASON_CHARS=300
# Wall-clock bound (seconds) on a single git command in the PR-gate submitter; a hung
# fetch/push is killed so it can never deadlock the process-wide submit lock.
CHEMCLAW_GIT_COMMAND_TIMEOUT_SECONDS=60.0
# Shared secret the git host signs its post-merge webhook with (HMAC-SHA256 over the raw
# body, sent as `X-Chemclaw-Signature: sha256=<hex>`). Empty leaves the webhook able to
# force a reindex but never to close a proposal as merged — set it wherever the host is
# allowed to record that a human signed off.
CHEMCLAW_NOTE_WEBHOOK_SECRET=
# Page size for GET /proposals (the PR-gate review queue). Paged by row id, so a proposal
# arriving mid-page cannot make the next page skip or repeat a row.
CHEMCLAW_PROPOSAL_LIST_LIMIT=50
# Max attempts for activities under the shared bad-data retry policy: caps transient
# retries so an unclassified deterministic failure gives up instead of retrying forever.
CHEMCLAW_ACTIVITY_MAX_ATTEMPTS=5
# Max attempts for a template's *agent* step alone — 1, i.e. no outer retry. Its own bound because
# an agent step is the one activity whose retry is not free: Temporal replays the turn from the
# prompt (an activity has no checkpointer), so every tool the failed attempt already ran runs again
# with its side effects. Measured: one provider 503 produced two PR-gate branches and two audit
# rows for one logical note. The retry that helps already happens inside the provider SDK
# (CHEMCLAW_LLM_MAX_RETRIES, in-process, no replay); this only removed the outer multiplier. The
# accepted cost: a long provider outage now fails the step in ~4 HTTP attempts instead of riding it
# out over 20. Raise it only knowing each extra attempt may duplicate a note and an audit row.
CHEMCLAW_AGENT_STEP_MAX_ATTEMPTS=1
# How many activities one worker process may run at once. temporalio's own default is 100, which
# is far more than the Postgres pool above can serve — and the shortfall does not fail loudly, it
# turns into retry churn, each starved activity spending one of the attempts above on a
# ConnectionError before computing anything. Matched to CHEMCLAW_PG_POOL_MAX_SIZE: an activity
# holds a connection for a fraction of its runtime, so equal already leaves the pool idle. Raise
# it for a worker whose activities are long waits rather than database work (the qm bundle's HPC
# polls), where memory is the real bound.
CHEMCLAW_WORKER_MAX_CONCURRENT_ACTIVITIES=8
# How long (seconds) a confirmed-answer note is held pending a human Yes/No (the chat
# "save knowledge?" button) before the hold expires unpublished. Default 7 days.
CHEMCLAW_INTERACTION_APPROVAL_TIMEOUT_SECONDS=604800.0

# Evaluation layer: versioned case-set directory, metric gates, prediction
# tolerance, and the (global) A/B noise floor.
CHEMCLAW_EVAL_CASE_DIR=data/evals/cases
CHEMCLAW_EVAL_EFACTOR_MAX=50.0
CHEMCLAW_EVAL_PMI_MAX=50.0
CHEMCLAW_EVAL_PREDICTION_TOLERANCE=1.0
CHEMCLAW_EVAL_AB_EPSILON=0.0
# F10-F2 — eval drift detection. Off by default; enabling adds a background Schedule that re-runs the
# committed case-set and alerts when an aggregate metric moves past a *relative* band (epsilon ×
# baseline value, so one knob fits metrics of different scales) vs the committed baseline.
CHEMCLAW_EVAL_DRIFT_ENABLED=false
CHEMCLAW_EVAL_DRIFT_SCHEDULE_MINUTES=1440
CHEMCLAW_EVAL_DRIFT_EPSILON=0.05
CHEMCLAW_EVAL_DRIFT_TIMEOUT_SECONDS=300.0
CHEMCLAW_EVAL_BASELINE_PATH=data/evals/baseline.json
# Share of the pinned hazard rules that must still fire on their reference molecules
# (hazard_flag_recall, D-080). 1.0: a silently-broken SMARTS means a hazard class goes
# unflagged, and the screen reports that as "nothing matched".
CHEMCLAW_EVAL_HAZARD_RECALL_MIN=1.0
# Retrieval-quality gate (KM-13): the gold-set corpus fixture + the recall floor the
# retrieval_recall metric gates against.
CHEMCLAW_EVAL_RETRIEVAL_CORPUS_DIR=data/evals/retrieval_corpus
CHEMCLAW_RETRIEVAL_RECALL_MIN=0.75
# Autonomy gates (F9-T3). These score a *scripted* transcript, so they measure the harness's
# plumbing — a plan is produced, work is closed before answering, the A/B arithmetic holds — and
# never the model's judgment, which needs the live endpoint AG-13 waits on. The plan floor is
# below 1.0 because an extra defensible step is not a regression while a missing required one is;
# the runaway ceiling is 0.0 because the pinned turns are scripted to finish, so any runaway among
# them is broken plumbing.
CHEMCLAW_EVAL_PLAN_QUALITY_MIN=0.8
CHEMCLAW_EVAL_RUNAWAY_MAX=0.0
# The M12 re-validation suites (plan gate, durable-launcher ordering, team routing). A directory
# *under* the probe corpus, because `load_probes` globs one level and a subdirectory is therefore
# invisible to `make live-probes` — these are scripted conversations and routing keys scored by
# their own suites, not corpus questions.
CHEMCLAW_LIVE_M12_PROBE_DIR=data/evals/probes/m12
# How long to wait for a turn's row in `turn_costs`. The ledger's write is scheduled rather than
# awaited (D-130), so it lands just after the stream closes; past this a turn is recorded as
# unmeasured rather than as free.
CHEMCLAW_LIVE_PROBE_COST_WAIT_SECONDS=5.0
# Share of the team arm's delegated turns that must reach the specialist the routing corpus names.
# The number M9 deferred `agent_teams_enabled` to: a supervisor that mis-routes is worse than the
# single agent it replaces.
CHEMCLAW_LIVE_ROUTING_ACCURACY_MIN=0.8

# Fingerprint search: ECFP4/DRFP definitions (must match the bit(N) columns in
# infra/sql) and the generic search knobs.
CHEMCLAW_ECFP_RADIUS=2
CHEMCLAW_ECFP_BITS=2048
CHEMCLAW_DRFP_BITS=2048
CHEMCLAW_FINGERPRINT_TOP_K=10
CHEMCLAW_FINGERPRINT_SIMILARITY_THRESHOLD=0.3
# Clamps on model-supplied search arguments (D-066 #4): a `top_k` above this is clamped, and the
# linear substructure scan stops after this many records with a loud truncation warning.
CHEMCLAW_FINGERPRINT_MAX_TOP_K=100
# How much deeper a *filtered* structural search looks than the page it returns: the fingerprint
# index carries no note metadata, so type/tag/date filters are applied to the neighbours after
# they come back. Still bounded by MAX_TOP_K above.
CHEMCLAW_RETRIEVAL_FILTER_OVERFETCH=5
CHEMCLAW_SUBSTRUCTURE_SCAN_MAX_RECORDS=5000
CHEMCLAW_SUBSTRUCTURE_QUERY_MAX_LENGTH=500
# Wall-clock bound (seconds) on one substructure scan's matching work: the record/length caps
# bound the inputs, this bounds the run, so an adversarial recursive SMARTS releases the caller
# with a clear error instead of stalling every other session's stream behind it.
CHEMCLAW_SUBSTRUCTURE_MATCH_TIMEOUT_SECONDS=5.0

# ELN ingestion: export directory of the JSON adapter + one sync batch's budget.
CHEMCLAW_ELN_EXPORT_DIR=data/eln-exports
CHEMCLAW_ELN_SYNC_TIMEOUT_SECONDS=300.0
# Entries ingested per sync activity, and the activity's heartbeat deadline.
CHEMCLAW_ELN_SYNC_BATCH_SIZE=100
CHEMCLAW_ELN_SYNC_HEARTBEAT_TIMEOUT_SECONDS=60.0
# Cursor slack (seconds). OVERLAP re-reads a window before the high-water mark so an entry
# written out of order is not missed; FUTURE_TOLERANCE bounds how far ahead of now a source
# timestamp may sit before it is treated as clock skew rather than a real future entry.
CHEMCLAW_ELN_SYNC_OVERLAP_SECONDS=86400.0
CHEMCLAW_ELN_SYNC_FUTURE_TOLERANCE_SECONDS=86400.0
# Directory the native Open Reaction Database (ORD JSON) adapter reads.
CHEMCLAW_ORD_EXPORT_DIR=data/eln-exports/ord
# Which sources the sync ingests is set by CHEMCLAW_DATA_SOURCES (below); each active ingest
# source carries its own high-water cursor in `sync_cursors`, keyed by its registry name.

# Memory layers: playbook similarity floor + synthesis job budget.
CHEMCLAW_PLAYBOOK_SIMILARITY_THRESHOLD=0.5
# Optimization campaigns group repeated runs of the SAME transformation (tighter floor).
CHEMCLAW_OPTIMIZATION_SIMILARITY_THRESHOLD=0.7
CHEMCLAW_MEMORY_JOB_TIMEOUT_SECONDS=300.0
# Most notes one synthesis run may propose (0 = unbounded). The window rotates by run date, so a
# corpus larger than the cap is covered over consecutive runs rather than having its tail dropped.
CHEMCLAW_MEMORY_MAX_NOTES_PER_RUN=25
# The ungated observations tier (D-161): cross-project patterns the agent notices, stored in
# Postgres rather than the graph because they are explicitly not truth. Off by default — it is the
# first knowledge surface no human signs off before the agent can read it, so a deployment chooses
# it. Needs migration 025. An observation crossing BOTH promotion thresholds opens one playbook PR
# through the ordinary PR-gate; one nothing re-observes for RETIRE_AFTER_DAYS is retired.
CHEMCLAW_OBSERVATIONS_ENABLED=false
CHEMCLAW_OBSERVATION_PROMOTE_MIN_EVIDENCE=3
CHEMCLAW_OBSERVATION_PROMOTE_MIN_PROJECTS=2
CHEMCLAW_OBSERVATION_RETIRE_AFTER_DAYS=30
CHEMCLAW_OBSERVATION_MAX_RESULTS=10
CHEMCLAW_OBSERVATION_SCHEDULE_MINUTES=1440.0

# Report harness: per-section retrieval budget. (The evidence excerpt length is
# CHEMCLAW_NOTE_EXCERPT_CHARS, in the retrieval block below — one knob, shared by the
# report retrievers and the memory summarizer.)
CHEMCLAW_REPORT_SECTION_TIMEOUT_SECONDS=300.0
# Max evidence chunks one gather_evidence sweep hands the agent (context-window budget).
CHEMCLAW_GATHER_EVIDENCE_MAX_CHUNKS=40
# F10-D — child-workflow fan-out: cap on concurrent children (report sections, memory groups).
CHEMCLAW_ORCHESTRATOR_MAX_PARALLEL_CHILDREN=8

# F10-A — hybrid retrieval. `hash` embedder is offline dev; `openai_compatible` uses the internal
# /embeddings endpoint. embedding_dim must match note_index.embedding vector(N) (infra/sql/010).
# retrieval_mode `graph` keeps the flat union (default); `hybrid` fuses sources by RRF. The vector/
# lexical retrievers are enabled by adding `vector`/`lexical` to CHEMCLAW_DATA_SOURCES.
CHEMCLAW_EMBEDDING_PROVIDER=hash
CHEMCLAW_EMBEDDING_MODEL=
CHEMCLAW_EMBEDDING_DIM=1536
# In-memory embedded-text cache (STO-12): every retrieval embeds its query and the same query
# recurs, so under a real provider each repeat was a network round trip. Keyed by
# provider+model+dim as well as the text, so a config change never serves the old model's
# vectors. 0 disables.
CHEMCLAW_EMBEDDING_CACHE_SIZE=2048
CHEMCLAW_RETRIEVAL_TOP_K=8
CHEMCLAW_RETRIEVAL_MODE=graph
CHEMCLAW_RETRIEVAL_FUSION_K=60
# Neutral score for a graph hit whose note has no confidence, used to rank-before-truncate (KM-5).
CHEMCLAW_RETRIEVAL_DEFAULT_CONFIDENCE=0.5
# Conflict signalling (KM-8): retrieval flags notes that disagree instead of returning both
# silently, which reads as corroboration. The gap is how far two same-compound, same-type notes'
# confidences must diverge before the pair is called suspicious.
CHEMCLAW_CONFLICT_CONFIDENCE_GAP=0.3
CHEMCLAW_CONFLICT_DETECTION_ENABLED=true
# How many disagreements one note's flag names, worst first. A pairwise scan over a corpus shaped
# like a real programme (many runs on one substrate) put ~141 ids on every evidence chunk, which is
# a fact about the corpus rather than a signal about the note. The count of the rest travels beside
# the list, so a truncation is never silent.
CHEMCLAW_CONFLICT_MAX_PER_NOTE=3

# Vendored reference data (STO-14) — the one sanctioned escalation of D-089's "no external data
# sources". A dataset is installed into the image at BUILD time and read from local disk here;
# nothing is fetched at runtime. Enable it by adding `vendored` to CHEMCLAW_DATA_SOURCES.
# Verification checks records.csv against the checksum in its manifest: the point of vendoring is
# that the shipped data is provably what was reviewed.
CHEMCLAW_VENDORED_DATASET_DIR=data/vendored
CHEMCLAW_VENDORED_DATASET_VERIFY=true

# The agent's chat client reads its provider API key from its own native env var
# (NOT a CHEMCLAW_ setting). For the default Anthropic client, set:
# ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# Foundation build F0–F7 (real target stack). Every value below is a Settings
# field; defaults keep local dev working with no tenant/cluster.
# ─────────────────────────────────────────────────────────────────────────────

# F0 — LLM provider seam. `openai_compatible` points at the internal endpoint with ONE generic
# API credential (not Entra — the documented exception); `anthropic` is the dev fallback.
CHEMCLAW_LLM_PROVIDER=anthropic
CHEMCLAW_LLM_BASE_URL=
CHEMCLAW_LLM_MODEL=
CHEMCLAW_LLM_API_KEY=
CHEMCLAW_LLM_TLS_CA_BUNDLE=
CHEMCLAW_LLM_TIMEOUT_SECONDS=60.0
CHEMCLAW_LLM_MAX_RETRIES=3

# Ask an OpenAI-compatible endpoint for token usage while streaming. On by default: LangChain only
# enables it automatically when no custom base URL and no custom HTTP client are set, and Chemclaw
# sets both — leaving it off metered every turn at zero. Turn off only for an endpoint that rejects
# `stream_options`, and expect the cost ledger to read zero if you do.
CHEMCLAW_LLM_STREAM_USAGE=true
# Left unset on purpose. Current frontier models (the default claude-sonnet-5) reject an explicit
# temperature — `400 invalid_request_error: temperature is deprecated for this model` — so setting
# this fails every turn on those models. Uncomment only for a model that still accepts one.
# CHEMCLAW_LLM_TEMPERATURE=0.0
CHEMCLAW_LLM_MAX_TOKENS=4096
# Anthropic prompt caching — mark the static prefix (tool schemas + system prompt) so a repeat call
# reads it at ~0.1x input price instead of re-sending it at 1x. On by default: that prefix is
# ~14,000 byte-identical tokens on the default profile (25,548 chars of system prompt + 29 tool
# schemas), and one agent turn makes a model call per tool round trip, so the 1.25x write premium
# is repaid inside the first turn. Ignored entirely on `openai_compatible` (no such parameter).
# Below the provider's minimum cacheable prefix (~1,024 tokens, higher on some models) it degrades
# silently — no entry, no error, `cache_read_tokens`/`cache_write_tokens` stay 0 in `turn_costs`.
CHEMCLAW_LLM_PROMPT_CACHING=true
# F10-E — per-task model routing (JSON task->model; empty keeps the single default model).
CHEMCLAW_MODEL_ROUTES={}
# F10-B — answer verification. When enabled, a drafted answer is scored for citation faithfulness by
# an LLM judge on the routed `verifier` model; an answer below the threshold is flagged for human
# review. Disabled = the deterministic report citation check, offline, no behavior change.
# AG-13 — the live probe harness. Probes are asked of a *running* deployment over the HTTP/SSE
# front door against a real model, so this is a gate you run against a deployment, never one CI
# runs on a diff. Their own directory, not the eval case-set: a probe is the input to a
# conversation that has not happened yet, an eval case is output already produced.
CHEMCLAW_LIVE_PROBE_DIR=data/evals/probes
CHEMCLAW_LIVE_PROBE_BASE_URL=http://127.0.0.1:8000
CHEMCLAW_LIVE_PROBE_TIMEOUT_SECONDS=300.0
CHEMCLAW_LIVE_PROBE_CONCURRENCY=4
CHEMCLAW_LIVE_PROBE_TRANSCRIPT_DIR=tasks/live-test/transcripts
# The judge grading an answer against its probe's direction. Deliberately a stronger model than
# the agent under test: it is one call per probe against the agent's many, and a judge sharing the
# agent's blind spots would ratify them.
CHEMCLAW_LIVE_PROBE_JUDGE_MODEL=claude-sonnet-5
# The judge's own output ceiling. At 1024 the reply truncated mid-JSON on long answers and the
# parse failure was recorded as a verdict of `unserved` — a grading crash reported as a system
# failure, on 65 of 190 probes in the first run.
CHEMCLAW_LIVE_PROBE_JUDGE_MAX_TOKENS=4096

CHEMCLAW_VERIFIER_ENABLED=false
CHEMCLAW_VERIFIER_CONFIDENCE_THRESHOLD=0.7
# The judge call's own deadline: on expiry the verifier degrades to the offline deterministic
# citation gate. Keep it far below CHEMCLAW_SERVICE_TURN_TIMEOUT_SECONDS — a stalled judge must
# cost the score, never the finished answer it is holding.
CHEMCLAW_VERIFIER_TIMEOUT_SECONDS=30.0
# The ungrounded-parameter scan over a drafted answer: shapes a chemist reads as specification —
# a flow rate, a gradient table, a wavelength, a back pressure, a column brand, an ICH limit, a
# polymorph form — marked for review when no tool in the turn produced them. Off by default and
# deliberately a deployment decision: it is a *shape* heuristic, and an answer marked for review
# that did not need it costs trust in every mark after it. The case for having it: a
# capability-boundary instruction cut invented parameter classes from 9 to 1 across the six worst
# live probes, and a stronger model still produced a full branded HPLC method table *while
# writing* "not a validated method".
CHEMCLAW_ANSWER_SHAPE_GATE_ENABLED=false


# M9 — route a turn through a supervisor and five specialists (evidence, computation, design,
# safety, reporting) instead of one agent. LangGraph engine only. Off until M12 measures routing
# accuracy against the single-agent baseline: a supervisor that mis-routes is worse than no team.
CHEMCLAW_AGENT_TEAMS_ENABLED=false

# F1 — autonomous plan/execute harness (off keeps today's classic agent).
CHEMCLAW_HARNESS_ENABLED=false
CHEMCLAW_HARNESS_AUTONOMY=plan_only
CHEMCLAW_HARNESS_MAX_LOOP_ITERATIONS=25

# Supersteps one model call costs, used to derive the graph's step ceiling
# (= CHEMCLAW_HARNESS_MAX_LOOP_ITERATIONS x this + 1; 151 at the defaults).
# `create_agent` bakes recursion_limit=9999 and reaching it raises
# GraphRecursionError, discarding the partial answer the loop cap exists to
# preserve - so this is the backstop under that cap, and on the classic path
# (harness off, no loop cap attached) it is the only bound there is.
# Measured 2 supersteps per model call with the harness off and 4 with it on;
# 6 is that with headroom, because the constant is the middleware count and
# moves whenever a middleware is added.
CHEMCLAW_AGENT_SUPERSTEPS_PER_MODEL_CALL=6
# How many times one turn may call a tool with the identical arguments before the call is refused.
# The loop cap above bounds harness iterations and says nothing about this: a live run called
# `find_past_jobs` 7-8 times in one turn. Two, not one, because a genuine re-check (a job polled
# after a wait) is a real pattern; 1 disables repeats entirely.
CHEMCLAW_MAX_IDENTICAL_TOOL_CALLS=2

# F2 — front-door service (FastAPI + SSE).
CHEMCLAW_SERVICE_HOST=0.0.0.0
CHEMCLAW_SERVICE_PORT=8080
CHEMCLAW_SERVICE_CORS_ORIGINS=
# Max characters accepted in one chat message (SEC-4; oversized -> 422).
CHEMCLAW_SERVICE_MAX_MESSAGE_CHARS=100000
# Response security headers (CSP/nosniff/frame-deny/HSTS) on the browser surface. On by default;
# set false only when an ingress/Route fronts its own header policy.
CHEMCLAW_SERVICE_SECURITY_HEADERS=true
# Explicit opt-in to boot UNAUTHENTICATED on a non-loopback bind (SEC-2). With ENTRA_REQUIRED
# false every request runs as the shared dev principal with all authorization gates open, so the
# front door refuses to start that way on an exposed interface unless this is true. Leave false.
CHEMCLAW_SERVICE_ALLOW_INSECURE=false
# Wall-clock bound (seconds) on one agent turn; a turn past this is cancelled rather than
# holding an admission permit forever.
CHEMCLAW_SERVICE_TURN_TIMEOUT_SECONDS=600.0
# Max concurrent SSE event streams one user may hold open (bounds per-user fan-out), and the
# same cap across all users on this process (the per-user cap alone does not bound the pod:
# 50 chemists at 5 streams each is 250 forever-polling streams on one event loop).
CHEMCLAW_SERVICE_MAX_EVENT_STREAMS_PER_USER=5
# Keepalive interval for both SSE streams. A long tool wait otherwise puts nothing on the wire,
# so an idle-connection reaper cannot tell it from a dead client (D-159).
CHEMCLAW_SERVICE_SSE_PING_SECONDS=15
CHEMCLAW_SERVICE_MAX_EVENT_STREAMS_TOTAL=200
# How long /readyz may reuse its connector sweep. The route is unauthenticated (a kubelet
# cannot present a token) and probed every 10s per pod, so an uncached sweep is an
# N-connector HTTP fan-out any caller can trigger. States are reported, never gating, so the
# only cost is staleness. 0 probes every request.
CHEMCLAW_SERVICE_READINESS_CACHE_SECONDS=5.0
# The readiness database probe's own statement budget, deliberately not the store timeout. Under
# SESSION_STORE=postgres a pod that cannot reach Postgres cannot serve a turn at all, so /readyz
# answers 503 — but a probe that hangs is worse than one that says no, and a SELECT 1 with no
# answer in two seconds has answered. /healthz stays green: an outage must drain these pods from
# the router, not restart them into a crash loop.
CHEMCLAW_SERVICE_READINESS_DB_TIMEOUT_SECONDS=2.0
# How many uvicorn worker PROCESSES the container starts. One event loop saturates one CPU, so
# this is the knob that lets the front door use a multi-CPU pod. The per-session turn guard is no
# longer a reason to keep it at 1 — under SESSION_STORE=postgres a turn takes a leased row in
# `session_turns`, which every process shares (D-121). What is still per-process is capability,
# not correctness: the admission cap (the deployment's real ceiling is this many times
# MAX_CONCURRENT_TURNS), the event-stream caps, uploaded attachments and harness todos. No ingress
# can pin a request below the pod, so a chemist who uploads a file and then asks about it needs
# one process per pod. Scale with replicas + Route affinity; raise this only where attachments and
# the harness are unused. Must stay 1 under SESSION_STORE=memory (no shared claim exists).
CHEMCLAW_SERVICE_UVICORN_WORKERS=1

# Turn/token budgets (D-066 #3). Off by default; when on, an over-budget turn is refused with
# 429. Counters are per-process and reset on restart (a durable quota is deferred).
CHEMCLAW_BUDGET_ENABLED=false
CHEMCLAW_BUDGET_MAX_TURNS_PER_SESSION=100
CHEMCLAW_BUDGET_MAX_TOKENS_PER_SESSION=2000000
CHEMCLAW_BUDGET_MAX_TURNS_PER_USER=1000
CHEMCLAW_BUDGET_MAX_TOKENS_PER_USER=20000000
# Cap on how many users the tracker holds counters for (LRU past this; bounds memory).
CHEMCLAW_BUDGET_MAX_TRACKED_USERS=10000

# F3 — durable sessions + job→session push-back (postgres store opt-in).
CHEMCLAW_SESSION_STORE=memory
CHEMCLAW_SESSION_STORE_DSN=
CHEMCLAW_SESSION_EVENT_POLL_SECONDS=2.0
# Cap on the front door's in-process live-session cache (LRU-evicted past this; COR-3).
CHEMCLAW_SERVICE_MAX_LIVE_SESSIONS=1000
# Cap on how many of a caller's sessions `GET /sessions` returns, newest first — the conversation
# list is a sidebar, not an archive export.
CHEMCLAW_SERVICE_MAX_LISTED_SESSIONS=100
# Admission control (AG-15): max concurrent agent turns, and how long a turn waits for a permit
# before it is shed with 503. Tune the cap to the internal LLM endpoint's throughput.
CHEMCLAW_SERVICE_MAX_CONCURRENT_TURNS=8
CHEMCLAW_SERVICE_TURN_ADMISSION_TIMEOUT_SECONDS=5.0
# What the cap above means for the *fleet*, which is the number the shared LLM endpoint sees. The
# guard is per-process by design, so the real ceiling is `replicas × uvicorn workers × the cap` —
# 48 for the shipped chart, and stated nowhere until these two settings. FLEET_REPLICAS is how many
# front-door pods may run (the chart derives it from `autoscaling.maxReplicas`, so it cannot drift);
# FLEET_MAX_CONCURRENT_TURNS is the ceiling the endpoint's throughput budget permits, and a
# configuration whose product exceeds it is refused at startup. 0 = undeclared, so a dev run with no
# fleet is not asked to have an opinion.
CHEMCLAW_SERVICE_FLEET_REPLICAS=1
CHEMCLAW_SERVICE_FLEET_MAX_CONCURRENT_TURNS=0
# How long a turn's claim on its session stays valid before another process may take it (D-121).
# A lease, not a lock: a lock would pin a pooled connection for the whole turn. Long enough to
# survive event-loop scheduling delays (measured worst case ~10s at 50 users), short enough that a
# crashed worker frees its session in about a minute instead of at the next restart.
CHEMCLAW_SERVICE_TURN_CLAIM_LEASE_SECONDS=60.0

# F4 — Entra identity & RBAC (system-wide; enforced only when ENTRA_REQUIRED=true).
CHEMCLAW_ENTRA_REQUIRED=false
CHEMCLAW_ENTRA_TENANT_ID=
CHEMCLAW_ENTRA_AUDIENCE=
CHEMCLAW_ENTRA_JWKS_URL=
CHEMCLAW_ENTRA_ISSUER=
CHEMCLAW_ENTRA_EXPENSIVE_ACTIONS=
CHEMCLAW_ENTRA_PRIVILEGED_ROLES=
# F10-C — per-tool authorization (enforced only under ENTRA_REQUIRED). JSON tool->roles; the
# default policy for an ungated tool is `allow` (today's behavior) or `deny` (allowlist mode).
CHEMCLAW_TOOL_ROLE_GATES={}
CHEMCLAW_TOOL_AUTHZ_DEFAULT=allow
CHEMCLAW_SERVICE_ACTOR_ID=service-account
# Workload identity federation (F4-T2) + OBO (F4-T4): no client secret at rest.
CHEMCLAW_ENTRA_WORKLOAD_FEDERATION_ENABLED=false
CHEMCLAW_ENTRA_WORKLOAD_CLIENT_ID=
CHEMCLAW_ENTRA_TOKEN_ENDPOINT=
CHEMCLAW_ENTRA_SA_TOKEN_PATH=/var/run/secrets/azure/tokens/azure-identity-token
CHEMCLAW_ENTRA_TOKEN_REFRESH_LEEWAY_SECONDS=300.0
CHEMCLAW_ENTRA_HTTP_TIMEOUT_SECONDS=10.0
# Floor between JWKS re-fetches forced by a token whose `kid` is not in the cached key set. PyJWT
# refetches on every such miss and the `kid` comes from an unauthenticated caller, so without this
# one credential-less request costs one outbound request to the tenant IdP. Trades bounded key-
# rotation latency for that: 0 restores PyJWT's unthrottled behaviour.
CHEMCLAW_ENTRA_JWKS_REFRESH_COOLDOWN_SECONDS=60.0
CHEMCLAW_ENTRA_OBO_ENABLED=false
# Fold the token's `groups` claim into the same role set every gate matches on, so an AD security
# group can be used as an entitlement (D-2026-08-06-a-share-is-mounted-not-called). Needed only
# where the tenant emits the optional `groups` claim and the gate names group *object-ids*; where
# the AD group is instead assigned to an Entra app role it arrives as a normal `roles` value and
# this stays false. A user in more groups than a token can carry gets a claim *overage* instead of
# `groups` — that is logged, not silently read as "no groups".
CHEMCLAW_ENTRA_GROUP_CLAIMS_AS_ROLES=false
# Non-Entra transport bridges (F4-T6): Temporal mTLS/API-key + the HPC identity bridge.
CHEMCLAW_TEMPORAL_TLS_CERT=
CHEMCLAW_TEMPORAL_TLS_KEY=
CHEMCLAW_TEMPORAL_TLS_CA=
CHEMCLAW_TEMPORAL_API_KEY=
CHEMCLAW_HPC_BRIDGE_IDENTITY=chemclaw-hpc

# F5 — real HPC via Nextflow (mock kept for CI). Pipeline version enters the cache key when set.
CHEMCLAW_HPC_LAUNCH_INTERFACE=mock
CHEMCLAW_HPC_API_BASE_URL=
CHEMCLAW_HPC_API_TOKEN=
CHEMCLAW_HPC_PIPELINE_NAME=
CHEMCLAW_HPC_PIPELINE_VERSION=
CHEMCLAW_HPC_ARTIFACT_STORE_URL=
# Real-run poll budgets (the nextflow path; the mock uses hpc_mock_run_seconds). start_to_close must
# cover the whole run (heartbeating does not extend it); heartbeat timeout sits above one poll's
# HTTP round-trip + poll interval; the HTTP timeout bounds each launcher/artifact call.
CHEMCLAW_HPC_RUN_TIMEOUT_SECONDS=86400.0
CHEMCLAW_HPC_RUN_HEARTBEAT_TIMEOUT_SECONDS=120.0
CHEMCLAW_HPC_HTTP_TIMEOUT_SECONDS=30.0

# F6 — OTLP collector endpoint (bridged to OTEL_EXPORTER_OTLP_ENDPOINT).
CHEMCLAW_OTEL_ENDPOINT=

# Where a *worker* process serves /healthz, /readyz and /metrics. The front door has
# CHEMCLAW_SERVICE_PORT; every other process had no HTTP surface, so its counters were uncollected
# and its liveness was a comment. Set the port to 0 to skip the surface — that is for running two
# workers on one machine, where the second cannot bind, not for a deployment.
CHEMCLAW_WORKER_METRICS_HOST=0.0.0.0
CHEMCLAW_WORKER_METRICS_PORT=9000
# How long an in-flight activity may finish after SIGTERM before the worker cancels it. Python
# installs no SIGTERM handler, so before this existed a node drain killed the process mid-activity
# and Temporal only re-ran the work after its start-to-close timeout elapsed.
CHEMCLAW_WORKER_GRACEFUL_SHUTDOWN_SECONDS=120.0

# F7 — where data-source manifests are discovered (OS-pathsep list, like PATH), and which of the
# discovered sources this deployment enables (comma list). Discovery is not enablement: the repo
# ships every source under sources/<name>/datasource.yaml, a deployment runs the subset it has
# validated. Earlier directories win a name collision, so a mounted folder can override a shipped
# source — which is how a second ELN drop with its own export_dir is configured (D-120):
#   /etc/chemclaw/sources/eln-json-staging/datasource.yaml
#     name: eln-json-staging
#     description: The staging ELN drop.
#     ingest: eln.json_adapter:JsonExportAdapter
#     config: {export_dir: /mnt/eln/staging}
# then add `eln-json-staging` to CHEMCLAW_DATA_SOURCES. No core edit, no image rebuild.
# Unset: defaults to what ships inside the installed package (D-141). Set this only to add
# or override a directory; it stays an OS-pathsep list, earlier entries winning.
# CHEMCLAW_DATA_SOURCES_DIR=
CHEMCLAW_DATA_SOURCES=graph,eln-json

# Mounted document shares (D-2026-08-06-a-share-is-mounted-not-called). Which share is mounted
# where, which folders to index, and who may read it is that source's *binding* in its
# datasource.yaml — see sources/sharedrive/datasource.yaml. Only the machinery's bounds are here,
# because they are about this deployment's Temporal and embedding budget, not about any one share.
# The job earns a Schedule only when an enabled source actually carries a share, so a deployment
# with none mounted fires nothing.
# Candidate documents one activity attempt considers before returning a cursor. The bound that
# lets a TB share make durable forward progress instead of wedging one over-window attempt.
CHEMCLAW_DOCUMENT_SYNC_BATCH_SIZE=500
CHEMCLAW_DOCUMENT_SYNC_TIMEOUT_SECONDS=900.0
CHEMCLAW_DOCUMENT_SYNC_HEARTBEAT_TIMEOUT_SECONDS=120.0
# Stale chunks one re-embedding pass refreshes. A chunk records which embedding configuration made
# its vector; changing CHEMCLAW_EMBEDDING_MODEL (or provider, or dim) makes every stored vector
# stale, and the next sync re-embeds them from the text already stored beside them — no crawl, no
# mount. Without this the table would hold a mix of two models' vectors and every comparison
# between them would be meaningless, with no error anywhere.
CHEMCLAW_DOCUMENT_REEMBED_BATCH_SIZE=500
# Chunks one workflow run drains before continuing as new, so event history stays bounded on a
# first full crawl.
CHEMCLAW_DOCUMENT_SYNC_MAX_ITERATIONS=100
# Six hours: a file share is not an ELN, its documents change over days, and even an unchanged
# crawl costs a full scandir pass over every path.
CHEMCLAW_DOCUMENT_SYNC_SCHEDULE_MINUTES=360
# The ceiling on a zip-container document's *expanded* size. .docx/.xlsx/.pptx are zips, so a
# binding's max_file_bytes bounds only what the file weighs on the share: a 110 KB workbook holding
# 31 MB of sheet XML is a measured 282x, under every byte limit, and it OOMs the worker. 512 MB is
# far above any real document and far below what kills a pod.
CHEMCLAW_DOCUMENT_MAX_EXPANDED_BYTES=536870912

# Pre-existing fields previously omitted from this file.
CHEMCLAW_PG_STATEMENT_TIMEOUT_SECONDS=30.0
# Migration locking. The first bounds how long a DDL statement waits for its table lock — a queued
# ACCESS EXCLUSIVE request blocks every later query on that table behind it, so an unbounded wait
# takes the table down rather than merely being slow. The second bounds waiting for another
# migrator, which is a legitimate event and gets a much larger budget.
CHEMCLAW_PG_MIGRATION_LOCK_TIMEOUT_SECONDS=5.0
CHEMCLAW_PG_MIGRATION_LOCK_WAIT_SECONDS=300.0
CHEMCLAW_ELN_SYNC_SCHEDULE_MINUTES=60.0
CHEMCLAW_MEMORY_SYNTHESIS_SCHEDULE_MINUTES=1440.0
CHEMCLAW_NOTE_EXCERPT_CHARS=240

# Structural hazard screening (D-080): the committed, cited SMARTS rule table, and the gate that
# makes an agent-proposed *procedure* note document its flags in a `## Hazards` section before
# kg-validate lets the PR through. The screen flags; it never clears — no match means no rule
# matched, not that the chemistry is safe.
# Unset: defaults to the rule table shipped inside the installed package (D-141). Set this to
# point a deployment at its own process-safety table.
# CHEMCLAW_SAFETY_RULES_PATH=
CHEMCLAW_SAFETY_GATE_SEVERITY=high
CHEMCLAW_SAFETY_GATE_ENABLED=true
# Most components one hazard/genotoxicity screen may carry. Both screens check their pair rules as
# a cross-product, so flags grow with the square of the list while the request stays tiny — 13 KiB
# of SMILES was measured producing 251,000 flags and blocking the connector's loop for 2.48 s.
# 64 is far above any real reaction. Over the limit is refused, never truncated: a screen that
# silently dropped components would report "no rule matched" for chemistry it never looked at.
CHEMCLAW_SAFETY_MAX_COMPONENTS=64
# Edge length in pixels of a rendered structure depiction (`render_structure`, gap TOOL-5).
CHEMCLAW_STRUCTURE_RENDER_SIZE_PX=320
# Scheduled rebuild of the derived note index (gap SCH-2). Only earns a Schedule where a hybrid
# retrieval leg actually reads the index; otherwise a graph-only deployment rebuilds for nothing.
CHEMCLAW_NOTE_REINDEX_ENABLED=false
CHEMCLAW_NOTE_REINDEX_SCHEDULE_MINUTES=60
CHEMCLAW_NOTE_REINDEX_TIMEOUT_SECONDS=600

# Scheduled verification of the tamper-evident audit chain (gap SCH-5).
CHEMCLAW_AUDIT_VERIFY_ENABLED=false
CHEMCLAW_AUDIT_VERIFY_SCHEDULE_MINUTES=1440
CHEMCLAW_AUDIT_VERIFY_TIMEOUT_SECONDS=600
# How many audit rows the chain verifier holds at once. `audit_events` is never pruned
# (deleting from a hash chain is indistinguishable from tampering), so it is the one
# unbounded table; the fold carries the chain link across pages.
CHEMCLAW_AUDIT_VERIFY_PAGE_ROWS=5000
# Retention windows (gap SCH-1). 0 = never prune that table; a deployment must state its policy.
CHEMCLAW_RETENTION_ENABLED=false
CHEMCLAW_RETENTION_SCHEDULE_MINUTES=1440
CHEMCLAW_RETENTION_TIMEOUT_SECONDS=600
CHEMCLAW_RETENTION_SESSION_EVENTS_DAYS=0
CHEMCLAW_RETENTION_SESSION_MESSAGES_DAYS=0
# Stored tool results (migration 042) — one row per tool call, so the fastest-growing table this
# sweep touches. It holds no record of anything (the answers are in calculation_results and
# job_records), so an age cutoff is the whole policy it needs. 0 = never prune, and 0 here really
# does mean unbounded growth: set it.
CHEMCLAW_RETENTION_TOOL_RESULTS_DAYS=0
# The LangGraph checkpoint tables (checkpoints, checkpoint_blobs, checkpoint_writes) — one
# deployment's worth of turn state. Created by the checkpointer's own setup() rather than by a
# migration in infra/sql, which is how they went unbounded without appearing in any schema review.
# Pruned by *thread*: a checkpoint chains to its parent, so a thread expires whole, when its newest
# checkpoint does. 0 = never prune. Days rather than years is the right order here — this is turn
# state a suspended turn resumes from, not the conversation record (that is session_messages).
CHEMCLAW_RETENTION_CHECKPOINTS_DAYS=0
# How many expired sessions one conversation-prune pass may work. The conversation prune costs
# three round trips per session (it cannot be one DELETE — whether an expired row may go depends
# on rows that are not expiring), so an uncapped first pass over a long backlog would exceed
# RETENTION_TIMEOUT_SECONDS and spend an attempt. Each pass commits per session, reports what it
# did not reach, and the schedule drains the tail.
CHEMCLAW_RETENTION_MAX_SESSIONS_PER_PASS=500
# Deterministic per-job phase offset as a fraction of the interval (gap SCH-3).
CHEMCLAW_SCHEDULE_JITTER_FRACTION=0.2
# Mid-turn durable-job resume (gap AGT-2). Must stay below CHEMCLAW_SERVICE_TURN_TIMEOUT_SECONDS.
CHEMCLAW_MID_TURN_RESUME_ENABLED=false
CHEMCLAW_MID_TURN_RESUME_TIMEOUT_SECONDS=60

# Per-retriever weight in the hybrid fusion (gap IDEA-5). JSON; empty = uniform (today's behavior).
CHEMCLAW_RETRIEVAL_SOURCE_WEIGHTS={}

# A connector's request timeout is per-manifest (`endpoint.request_timeout` in its connector.yaml),
# not a global: an unreachable host must not hang a turn, but how long a capability legitimately
# takes is that capability's property. Same for its auth mode (`endpoint.auth`), whose bearer variant
# names the env var to read — the token itself never lives in a manifest.

# Per-user working preferences (gap AGT-4) are stored in `user_preferences` (migration 015) when
# CHEMCLAW_SESSION_STORE=postgres; otherwise they are in-process only (dev/tests).

# Predicted-vs-actual calibration ledger (gap IDEA-2); needs migration 016.
CHEMCLAW_CALIBRATION_ENABLED=false
CHEMCLAW_CALIBRATION_MIN_OBSERVATIONS=8
# Ceiling on one `find_calculations` result page; needs migration 024's indexes to stay cheap.
CHEMCLAW_CALC_FIND_MAX_RESULTS=50
# Ceiling on how much of one artifact `fetch_artifact` reads into the model's context.
CHEMCLAW_CALC_ARTIFACT_MAX_CHARS=20000
# Ceiling on one `calculator_outliers` page; needs migration 016's predictions ledger.
CHEMCLAW_CALC_OUTLIERS_MAX_RESULTS=25
# Standing-query digests (gap IDEA-1); needs migration 017.
CHEMCLAW_DIGEST_ENABLED=false
CHEMCLAW_DIGEST_SCHEDULE_MINUTES=1440
CHEMCLAW_DIGEST_TIMEOUT_SECONDS=300
# Uploaded working files (gap AGT-3).
CHEMCLAW_ATTACHMENT_MAX_BYTES=2000000
CHEMCLAW_ATTACHMENT_MAX_PER_SESSION=10
# Parsing an upload runs in a worker thread under these two bounds, never inline on the event loop:
# one hostile document within the size cap would otherwise freeze every session, stream and health
# probe on the pod (the front door runs one uvicorn worker). Uploads past the concurrency cap are
# shed with 503 rather than queued.
CHEMCLAW_ATTACHMENT_PARSE_TIMEOUT_SECONDS=30
CHEMCLAW_ATTACHMENT_PARSE_QUEUE_SECONDS=10
CHEMCLAW_ATTACHMENT_MAX_CONCURRENT_PARSES=2

# Per-principal request budget (a token bucket, spent inside `require_principal` so it covers every
# authenticated route and none of the probes). 0 disables, which is the code default — a CLI or a
# single-user dev run has no reason to be throttled; the chart turns it on. `burst` is what a caller
# may spend at once; `max_principals` bounds the LRU that holds the buckets, because a map keyed by
# caller identity with an attacker-influenced key is the classic unbounded-growth bug.
CHEMCLAW_SERVICE_RATE_LIMIT_PER_MINUTE=0.0
CHEMCLAW_SERVICE_RATE_LIMIT_BURST=30.0
CHEMCLAW_SERVICE_RATE_LIMIT_MAX_PRINCIPALS=10000
# Hard ceiling on a request body, refused with 413 before anything reads it. Above
# CHEMCLAW_ATTACHMENT_MAX_BYTES because a multipart envelope wraps the file in boundaries and
# headers. 0 disables.
CHEMCLAW_SERVICE_MAX_REQUEST_BYTES=4000000
# The uvicorn transport bounds (read by deploy/entrypoint.sh). None can be imposed by the app: by
# the time a request reaches an ASGI app the socket is accepted and the headers are parsed.
# max_connections bounds sockets, not turns, and sits far above the turn cap on purpose.
CHEMCLAW_SERVICE_MAX_CONNECTIONS=256
CHEMCLAW_SERVICE_KEEPALIVE_SECONDS=15
CHEMCLAW_SERVICE_MAX_HEADER_BYTES=32768

# HMAC key for the audit-chain high-water anchors. Empty disables anchoring — deliberately, because
# an anchor is only evidence if its secret lives somewhere a database compromise does not reach. The
# chain catches modification, reordering, interior deletion and prefix truncation and cannot see a
# *trailing* deletion; a point-in-time restore is a trailing deletion, so without this a documented
# recovery procedure silently shortens the compliance trail every time it is used.
CHEMCLAW_AUDIT_ANCHOR_SECRET=

# One JSON object per log line instead of CHEMCLAW_LOG_FORMAT's `%`-string. Off in code, on in the
# chart: a developer reading a terminal wants the string, a cluster log stack wants to parse. Every
# line carries correlation_id / actor / session_id either way, which is what joins an ordinary
# WARNING to the audit trail and to a conversation.
CHEMCLAW_LOG_JSON=false
