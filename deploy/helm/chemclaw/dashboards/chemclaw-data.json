  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "singlestat",
      "title": "Cache hit ratio (1h)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "span": 2,
      "format": "percentunit",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(increase(chemclaw_calc_cache_total{outcome=~\"hit|shared\"}[1h])) / clamp_min(sum(increase(chemclaw_calc_cache_total[1h])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "singlestat",
