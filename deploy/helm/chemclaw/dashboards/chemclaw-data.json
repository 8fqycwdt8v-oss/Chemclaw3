      "xaxis": {
        "mode": "time",
        "show": true
      },
      "targets": [
        {
          "expr": "max by (pod) (chemclaw_knowledge_sync_age_seconds)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "graph",
      "title": "Checkpointer: statements waiting on the saver lock",
      "description": "The saver serialises every checkpoint write on one asyncio lock, which is invisible to the pool gauges above: measured, 8 concurrent turns ran at concurrency 1 inside the saver with 612 ms of maximum wait while chemclaw_pg_pool_requests_waiting read 0. These two series are what makes that queue visible. A rising wait with a flat pool is the saver, not the database.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "expr": "max(chemclaw_checkpointer_statements_waiting)",
          "legendFormat": "waiting (max over pods)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chemclaw_checkpointer_lock_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 lock wait",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
