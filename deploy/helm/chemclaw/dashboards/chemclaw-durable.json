{
  "__comment": "The Temporal tier: what is running, what is failing, and whether the workers are polling.",
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "singlestat",
      "title": "Jobs in flight",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "span": 2,
      "format": "short",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(chemclaw_jobs_in_flight)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "singlestat",
      "title": "Job success ratio (30m)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "span": 2,
      "format": "percentunit",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(rate(chemclaw_jobs_finished_total{outcome=\"completed\"}[30m])) / clamp_min(sum(rate(chemclaw_jobs_finished_total[30m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "singlestat",
      "title": "Job p95",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "span": 2,
      "format": "s",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chemclaw_job_duration_seconds_bucket[30m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "singlestat",
      "title": "Temporal probe failures (1h)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "span": 2,
      "format": "short",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(increase(chemclaw_durable_unreachable_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "singlestat",
      "title": "Activities cancelled on drain (1h)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "span": 2,
      "format": "short",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(increase(chemclaw_worker_activities_cancelled_on_drain_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "singlestat",
      "title": "Push-backs dropped (1h)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "span": 2,
      "format": "short",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(increase(chemclaw_pushback_dropped_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "graph",
      "title": "Job outcomes by connector",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "span": 6,
      "fill": 0,
      "stack": false,
      "linewidth": 2,
      "nullPointMode": "null",
      "legend": {
        "show": true,
        "current": true,
        "max": true,
        "values": true
      },
      "tooltip": {
        "shared": true,
        "sort": 2,
        "value_type": "individual"
      },
      "yaxes": [
        {
          "format": "reqps",
          "show": true,
          "min": 0
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      },
      "targets": [
        {
          "expr": "sum by (connector, outcome) (rate(chemclaw_jobs_finished_total[30m]))",
          "legendFormat": "{{connector}} {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(chemclaw_jobs_started_total[30m]))",
          "legendFormat": "started",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "graph",
      "title": "Job duration p95 by connector",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "span": 6,
      "fill": 0,
