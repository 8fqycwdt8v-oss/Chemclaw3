        "show": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chemclaw_hypothesis_position_bias_bucket[1d])))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(chemclaw_hypothesis_position_bias_bucket[1d])))",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "type": "graph",
      "title": "Hypotheses rejected before the tournament",
      "description": "The screen is the only stage allowed to delete a candidate, and it deletes quietly. Both rules are mechanical: `no-refutation-condition` removes a hypothesis that names no observation which would contradict it. A step change here after a model or prompt change means the generator has stopped producing falsifiable hypotheses \u2014 the field a chemist sees gets smaller and better-looking at the same time, which is the least visible way this feature can degrade.",
      "datasource": "prometheus",
      "gridPos": {
