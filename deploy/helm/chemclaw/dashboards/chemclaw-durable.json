        "show": true,
        "current": true,
        "max": true,
        "values": true
      },
      "tooltip": {
        "shared": true,
        "sort": 2,
        "value_type": "individual"
      },
      "yaxes": [
        {
          "format": "s",
          "show": true,
          "min": 0
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, connector) (rate(chemclaw_job_duration_seconds_bucket[30m])))",
          "legendFormat": "{{connector}} p95",
          "refId": "A"
        },
        {
          "expr": "sum by (connector) (rate(chemclaw_job_runtime_seconds_total[30m]))",
          "legendFormat": "{{connector}} runtime seconds/second",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "graph",
      "title": "Activity failures by activity",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "span": 6,
      "fill": 0,
