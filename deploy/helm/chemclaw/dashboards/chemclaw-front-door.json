  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "singlestat",
      "title": "Requests/second",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "span": 2,
      "format": "reqps",
      "decimals": 2,
      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(rate(chemclaw_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
