      "valueName": "current",
      "sparkline": {
        "show": true
      },
      "targets": [
        {
          "expr": "sum(rate(chemclaw_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(chemclaw_http_requests_total[5m])), 0.001)",
