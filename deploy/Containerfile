# Single multi-target image for every Chemclaw component (plan F6-T1).
#
# One image, one dependency closure; the *component* is chosen at runtime by CHEMCLAW_COMPONENT
# (see deploy/entrypoint.sh), so the service, the two Temporal workers, and the MCP servers all ship
# the same bits and differ only by entrypoint. UBI9 + a non-root UID keeps it OpenShift-SCC-friendly
# (arbitrary high UID at runtime); no secret is ever baked in — all config arrives via env/mounts.
# The base is an ARG so a release can pin it by digest without editing this file. It defaults to a
# floating tag, and that default is a deliberate, stated compromise rather than an oversight: a
# digest written here would be stale within weeks and every developer build would then pull a base
# missing months of CVE fixes. So the *dev* default floats and a *release* pins, which is the same
# split `image.digest` makes in the chart. `docs/guides/runbook.md` §(xiv) is the procedure:
#
#   docker build --build-arg BASE_IMAGE=registry.access.redhat.com/ubi9/python-311@sha256:<...>
#
# A floating base is exactly why the dependency audit and the SBOM in `.github/workflows/image.yml`
# record what a build actually contained: if the bytes cannot be pinned in advance, they must at
# least be *named* afterwards.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/python-311:latest
FROM ${BASE_IMAGE}

# uv drives the install to match local/CI exactly (same lockfile). Copy metadata first for layer reuse.
# `git` is a hard runtime dependency, not a convenience: the PR-gate submitter shells out to it
# (`kg/git_submitter.py`) and the knowledge-sync sidecar clones/pulls the note repo with it, so an
# image without git silently breaks both directions of the knowledge layer.
#
# `rsync` is a hard runtime dependency for the same reason, and its absence was worse than a broken
# feature. `knowledge-sync.sh` publishes the read replica with `rsync -a --delete`, and its fallback
# for a failed rsync was `rm -rf "${publish_dir}"/*` followed by `cp -a`. This image never installed
# rsync, and the rsync call swallowed stderr — so `command not found` was indistinguishable from a
# transfer error and the *destructive* branch was the one that always ran, every sync interval,
# against the directory the serving container reads live. `kg/graph.py` caches on a stat
# fingerprint with a short TTL, so a retrieval landing inside that window saw a partial or empty
# graph and the agent answered with no evidence — silently, because a missing note is not an error.
USER 0
# `dnf -y update` before installing, and it is not belt-and-braces. Red Hat rebuilds the UBI9 tag
# periodically, so `:latest` lags the errata stream — the first run of the image scan found fixable
# HIGH/CRITICAL advisories in openssh, openssl, python3 and python3-urllib3, every one of them
# already fixed upstream and simply not yet in the base build. Applying the current errata at build
# time is what makes the floating-base decision coherent: the base moves when Red Hat rebuilds it,
# and the *packages* move on every build regardless.
#
# `setuptools` is upgraded for the same reason one level up. The base ships 65.5.1, which carries
# two HIGH advisories (CVE-2024-6345, CVE-2025-47273) fixed in 70.0.0 and 78.1.1. It is the
# *interpreter's* setuptools rather than a locked dependency — `uv export | pip-audit` is clean —
# so no lockfile change could have reached it, and it would have gone unnoticed for exactly as long
# as nobody scanned the built image.
RUN dnf -y update && dnf install -y git rsync && dnf clean all \
    && pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir uv
WORKDIR /app

# The two calculation binaries (xTB plan X5/X6). Pinned release tarballs rather than a
# package manager, because UBI9 has neither in its repositories and a pinned artifact is
# what makes the image reproducible. Both are optional at *runtime* — `calc.xtb_cli` and
# `calc.crest_cli` fall back or report unavailable — but a worker image without them
# loses the 9-11x ANCopt speedup and conformer sampling entirely.
#
# Licensing: xtb is LGPL-3.0, crest is GPL-3.0. Both are invoked as separate processes
# over files and never linked, so the usual analysis is that neither affects this
# codebase's licence — but *distributing* them inside an image is a decision for whoever
# owns the product, and this file cannot make it.
#
# What it can do is stop the decision from requiring a code change. `INCLUDE_CREST=false` builds
# without the GPL-3.0 binary: `calc.crest_cli` already reports unavailable rather than failing, so
# the image loses conformer sampling and nothing else. The instruction used to be "drop the crest
# layer", which meant editing a RUN block, which meant the decision was never taken because taking
# it looked like a patch. It is now a build argument and a row in the backlog naming the owner.
#
# The xtb link is resolved by *finding* the extracted binary rather than guessing its directory.
# The previous form tried `/opt/xtb-dist/bin/xtb` and fell back to `/opt/xtb-${XTB_VERSION}/bin/xtb`
# — but `ln -s` succeeds when its target does not exist, creating a dangling link, so the `||`
# fallback could never run and the version check below failed with 127. The 6.6.1 tarball extracts
# to `xtb-6.6.1/`, i.e. exactly the path the unreachable fallback named, so **this image had never
# built**. Nothing noticed because the workflow that builds it was stranded under
# `services/chemclaw/.github/`, where GitHub Actions never reads (both fixed in D-117).
ARG XTB_VERSION=6.6.1
ARG CREST_VERSION=3.0.2
ARG INCLUDE_CREST=true
RUN set -eux; \
    curl -fsSL -o /tmp/xtb.tar.xz \
      "https://github.com/grimme-lab/xtb/releases/download/v${XTB_VERSION}/xtb-${XTB_VERSION}-linux-x86_64.tar.xz"; \
    tar -xJf /tmp/xtb.tar.xz -C /opt; \
    xtb_bin="$(find /opt -maxdepth 4 -type f -name xtb -perm -u+x -print -quit)"; \
    test -n "${xtb_bin}" || { echo "no xtb binary under /opt after extraction" >&2; exit 1; }; \
    ln -sfn "${xtb_bin}" /usr/local/bin/xtb; \
    if [ "${INCLUDE_CREST}" = "true" ]; then \
      curl -fsSL -o /tmp/crest.tar.xz \
        "https://github.com/crest-lab/crest/releases/download/v${CREST_VERSION}/crest-gnu-12-ubuntu-latest.tar.xz"; \
      mkdir -p /opt/crest && tar -xJf /tmp/crest.tar.xz -C /opt/crest --strip-components=1; \
      install -m 0755 /opt/crest/crest /usr/local/bin/crest; \
      rm -f /tmp/crest.tar.xz; \
      crest --version >/dev/null; \
    fi; \
    rm -f /tmp/xtb.tar.xz; \
    xtb --version >/dev/null

COPY pyproject.toml uv.lock README.md ./
# All first-party code, in one COPY. Before D-141 this was eighteen lines, one per top-level
# package, and a new package that nobody added here was simply missing from the image — which is
# how `connectors/` and `templates/` came to be absent from the wheel and coverage lists too.
# One package means there is nothing left to forget.
COPY src ./src
# The data the application reads from disk at start-up, none of which is code. Since D-156 the
# corpora are one tree: `data/` holds the agent profiles and step templates (both discovered from
# disk, so an image missing them silently advertises fewer capabilities rather than failing), the
# committed eval case-set and baseline the drift job scores against, the vendored dataset and the
# sample ELN exports. `skills/` and `knowledge/` stay separate because they are architecture layers
# 3 and 4 rather than configuration — `skills/` IS the agent's judgment layer (an image without it
# advertises no skills at all) and `knowledge/` seeds the note tree so the mount point exists before
# the first sync. `infra/` holds the SQL migrations the migrate Job runs.
COPY data ./data
COPY skills ./skills
COPY knowledge ./knowledge
COPY infra ./infra
COPY deploy/entrypoint.sh /usr/local/bin/chemclaw-entrypoint
COPY deploy/knowledge-sync.sh /usr/local/bin/chemclaw-knowledge-sync

# Install into a project venv; --frozen fails if the lockfile drifted (reproducible builds).
RUN uv sync --frozen --no-dev \
    && chmod +x /usr/local/bin/chemclaw-entrypoint /usr/local/bin/chemclaw-knowledge-sync \
    && chown -R 1001:0 /app \
    && chmod -R g=u /app

# Sweep every Python environment in the image, not just the application's.
#
# The image scan found `setuptools` 70.3.0 and `msgpack` 1.1.2 with fixable HIGH advisories, and
# neither is ours: `uv.lock` pins setuptools 83.0.0 and does not contain msgpack at all. They live
# in the *base image's* Python environments — the UBI9 layer ships more than one interpreter, each
# with its own `site-packages` — which is exactly the class of finding a lockfile audit is blind to
# and the reason the row asked for an image scan as well as a dependency scan.
#
# Upgraded rather than removed, and only where already installed: `--upgrade` on an absent package
# would *add* it, growing the closure to fix a vulnerability that was not there. Something in the
# base may depend on either, and breaking the base's own tooling to satisfy a scanner trades a
# reported problem for an unreported one — the smoke step that imports every component under a
# non-root UID is what would catch that, and it should not have to.
#
# The interpreters are *discovered*, not listed. A hardcoded list of four plausible paths missed
# whichever environment actually holds these — `[ -x ... ] || continue` skipped every guess in
# silence, and the scan came back with the identical two findings. A list of guesses that fails
# quietly is the same shape of bug as a probe that always passes.
#
# The trailing `find` is the diagnostic half and stays in the build: it prints every remaining
# `dist-info` for the two packages, so a future finding names its path in the build log instead of
# costing a round trip through CI to locate.
RUN set -eux; \
    interpreters="$(find /usr/bin /usr/local/bin /opt -maxdepth 4 -name 'python3*' -type f \
      -perm -u+x -print 2>/dev/null | sort -u)"; \
    echo "interpreters found:"; echo "${interpreters}"; \
    for py in ${interpreters}; do \
      "${py}" -m pip --version >/dev/null 2>&1 || continue; \
      if "${py}" -m pip show setuptools >/dev/null 2>&1; then \
        "${py}" -m pip install --no-cache-dir --upgrade 'setuptools>=78.1.1' >/dev/null; \
      fi; \
      if "${py}" -m pip show msgpack >/dev/null 2>&1; then \
        "${py}" -m pip install --no-cache-dir --upgrade 'msgpack>=1.2.1' >/dev/null; \
      fi; \
    done; \
    echo "remaining dist-info for the two packages:"; \
    find / -xdev \( -name 'setuptools-*.dist-info' -o -name 'msgpack-*.dist-info' \) \
      -print 2>/dev/null || true

# The revision this image was built from, stamped onto every audit record (AG-14 / REV-17). The
# config docstring has always said "the F6 image build injects the digest" and no build ever did —
# nothing in the Containerfile, the chart or CI set it, so `deployment_revision` was "unknown" in
# every deployment while AG-14 read as met. A GxP trail whose "which version produced this result"
# column is a constant is not answering the question it exists to answer.
#
# A build ARG rather than a chart value because the image is the thing that has a revision: a chart
# can be re-rendered against any tag, and a value that disagrees with the bytes is worse than the
# honest "unknown". Defaulted so a local `docker build` still works and says plainly that it does
# not know. `envFrom` a ConfigMap does not clobber an image ENV, so a deployment that wants to
# override it can still put the key in `.Values.config`.
ARG CHEMCLAW_REVISION=unknown

# Non-root by default; OpenShift may override with an arbitrary UID (still in group 0).
USER 1001
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    CHEMCLAW_COMPONENT=service \
    CHEMCLAW_DEPLOYMENT_REVISION=${CHEMCLAW_REVISION}

ENTRYPOINT ["/usr/local/bin/chemclaw-entrypoint"]
